  visitorReply: "\u5BA2\u5B98\uFF0C\u60F3\u770B\u4EC0\u4E48\u6B3E\u5F0F\u7684\u8863\u88F3\uFF1F"
  tailorReplies:
  - "\u60A8\u4ECA\u5929\u5934\u4E00\u56DE\u6765\uFF0C\u8FD8\u6CA1\u8BA2\u8FC7\u8863\u670D\uFF0C\u5148\u770B\u770B\u6B3E\u5F0F\u5427\u3002"
  - "\u60A8\u6628\u65E5\u8BA2\u7684\u9ED1\u8272\u957F\u886B\u5DF2\u7ECF\u505A\u597D\u4E86\uFF0C\u8BA2\u91D1\u4E5F\u6536\u5230\u4E86\u3002\u73B0\u5728\u62FF\u7ED9\u60A8\u5417\uFF1F"
  - "\u60A8\u662F\u966A\u4EBA\u6765\u7684\u5427\uFF1F\u53D6\u8863\u7684\u90A3\u4F4D\u8FD8\u6CA1\u6765\u3002"
  receivedReply: "\u60A8\u8BA2\u7684\u957F\u886B\u5DF2\u7ECF\u53D6\u8D70\u4E86\uFF0C\u8FD8\u60F3\u770B\u770B\u522B\u7684\u5417\uFF1F"
  handoverReply: "\u7ED9\uFF0C\u60A8\u7684\u9ED1\u8272\u957F\u886B\u3002\u5DF2\u5B58\u5165\u80CC\u5305\uFF0C\u6536\u597D\u4E86\u3002"
