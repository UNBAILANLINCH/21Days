      "kind": "Line",
      "speaker": "",
      "speakerName": "",
      "side": "Left",
      "expression": "",
      "clearOther": false,
      "text": "【仪凤三年，泾阳大水】",
      "next": "r0145",
      "outcome": "",
      "blocking": true,
      "performance": "",
      "choices": []
    },
    {
