      "revision": 1,
      "kind": "Line",
      "speaker": "",
      "speakerName": "赵十四",
      "side": "Left",
      "expression": "",
      "clearOther": false,
      "text": "我只送你到门口了。",
      "next": "r0127",
      "outcome": "",
      "blocking": true,
      "performance": "",
      "choices": []
    },
    {
      "id": "r0127",
