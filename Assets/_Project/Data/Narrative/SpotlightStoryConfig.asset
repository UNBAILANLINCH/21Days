  - stageId: enter_r0215
    displayName: "\u6BB7\u7EA2"
    verb: "\u4EA4\u8C08"
    hint: "\u5230\u5DF7\u53E3\u9760\u8FD1\u6BB7\u7EA2\uFF0C\u6309 {Interact} \u4EA4\u8C08\u3002"
  - stageId: enter_r0293
    displayName: "\u8F6E\u56DE\u5802\u65B9\u5411"
    verb: "\u4EA4\u8C08"
    hint: "\u672C\u6BB5\u5DF2\u5B8C\u6210\u3002\u6BB7\u7EA2\u5C06\u5E26\u4F60\u524D\u5F80\u8F6E\u56DE\u5802\u3002"
  guides:
  - action: 0
    text: 
  - action: 1
    text: "\u9760\u8FD1\u4EBA\u7269\u540E\u6309 {Interact} \u4EA4\u8C08\u3002"
  - action: 2
    text: "\u6309\u4F4F {Sneak} \u6F5C\u884C\uFF0C\u7ED5\u5230\u672A\u5BDF\u89C9\u76EE\u6807\u80CC\u540E\uFF0C\u6309
      {Secondary} \u53D6\u76AE\u3002"
  - action: 3
    text: "\u76AE\u5DF2\u5165\u5305\u3002\u518D\u6B21\u9760\u8FD1\u6765\u6E90\u6309
      {Secondary} \u6362\u76AE\uFF0C\u6216\u6309 {Inventory} \u6253\u5F00\u80CC\u5305\u4F7F\u7528\u3002"
  - action: 4
    text: "\u4EE5\u5B66\u5F92\u8EAB\u4EFD\u9760\u8FD1\u5DE1\u903B\u5B66\u5F92\uFF0C\u6309
      {Interact} \u6838\u5BF9\u540D\u518C\u3002"
  - action: 5
    text: "\u4EE5\u90FD\u77E5\u8EAB\u4EFD\u9760\u8FD1\u5DE1\u903B\u5B66\u5F92\uFF0C\u6309
      {Interact} \u8C03\u6574\u8DEF\u7EBF\u3002"
  - action: 6
    text: "\u4EE5\u4E50\u6B63\u8EAB\u4EFD\u9760\u8FD1\u90FD\u77E5\uFF0C\u6309 {Interact}
      \u8FDB\u5165\u6F14\u594F\u3002"
  - action: 7
    text: "\u5411\u987E\u5BA2\u4E0E\u88C1\u8863\u5320\u8BE2\u95EE\u8BA2\u8863\u60C5\u51B5\uFF0C\u5224\u65AD\u8C01\u6765\u53D6\u8863\uFF0C\u518D\u6362\u76AE\u9886\u53D6\u3002"
  - action: 8
    text: "\u4EE5\u5B98\u8BC1\u8EAB\u4EFD\u4E0E\u91D1\u94F6\u5320\u4EA4\u8C08\uFF0C\u8865\u8DB3\u91D1\u5C5E\u4EFD\u989D\u3002"
  - action: 9
    text: "\u4EE5\u91D1\u94F6\u5320\u8EAB\u4EFD\u6253\u5F00\u6253\u9020\u53F0\uFF1B\u6309\u9AD8\u4EAE\u70B9\u4F4D\u5B8C\u6210\u5DE5\u4EF6\uFF0C\u91D1\u5C5E\u4E0D\u8DB3\u53EF\u627E\u5B98\u8BC1\u8865\u6599\u3002"
  - action: 10
    text: "\u4EE5\u9152\u5BA2\u8EAB\u4EFD\u9760\u8FD1\u7532\u3001\u4E59\u6216\u4E3B\u4EBA\uFF0C\u6309
      {Interact} \u5212\u62F3\u3002\u5404\u51FA\u4E00\u624B\uFF0C\u558A\u53CC\u65B9\u603B\u6570\uFF0C\u8F93\u8005\u559D\u9152\u3002"
  - action: 11
    text: "\u4E3B\u4EBA\u5DF2\u6709\u9189\u610F\u3002\u9760\u8FD1\u6309 {Interact}
      \u6311\u6218\uFF0C\u4E5F\u53EF\u7EE7\u7EED\u5212\u62F3\u589E\u52A0\u9189\u610F\u3002"
  - action: 12
    text: "\u9760\u8FD1\u6BB7\u7EA2\uFF0C\u6309 {Interact} \u7EE7\u7EED\u4EA4\u8C08\u3002"
  - action: 13
    text: "\u672C\u6BB5\u5DF2\u5B8C\u6210\uFF1A\u6BB7\u7EA2\u5C06\u5E26\u4F60\u524D\u5F80\u8F6E\u56DE\u5802\u3002"
  interactionRadius: 2.5
