# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash / misc
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# OS
.DS_Store
Thumbs.db

# Luban 工具本体（第三方二进制，约 30 MB）。scripts/gen-tables.ps1 发现缺失会自动下载解压，
# 不必进库；生成出来的代码与 .bytes 照常进 git。
/Tools/Luban/

# Claude Code 本机覆盖配置
.claude/settings.local.json

# Claude Code 运行缓存（钩子计数、已读记录、压缩快照）
.claude/.cache/

# Python 脚本（钩子 / lint / 扫描）运行产生的字节码缓存
__pycache__/
