      "kind": "Line",
      "speaker": "",
      "speakerName": "",
      "side": "Left",
      "expression": "",
      "clearOther": false,
      "text": "【泾水暴涨，坏民田，摧民宅，溺死者三千七百人。】",
      "next": "r0146",
      "outcome": "",
      "blocking": true,
