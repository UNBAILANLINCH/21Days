    },
    {
      "id": "r0003",
      "revision": 1,
      "kind": "Line",
      "speaker": "storyteller",
      "speakerName": "说书人",
      "side": "Left",
      "expression": "",
      "clearOther": false,
      "text": "内侍高声唱道：“侲子备，请逐咎——”",
      "next": "r0004",
      "outcome": "",
      "blocking": true,
      "performance": "",
      "choices": []
    },
    {
      "id": "r0004",
      "revision": 1,
      "kind": "Line",
      "speaker": "storyteller",
      "speakerName": "说书人",
      "side": "Left",
      "expression": "",
      "clearOther": false,
      "text": "众声应和：“新阳肇生，万物咸昌。”",
      "next": "r0005",
      "outcome": "",
      "blocking": true,
      "performance": "",
      "choices": []
    },
    {
      "id": "r0005",
      "revision": 1,
      "kind": "Line",
      "speaker": "storyteller",
      "speakerName": "说书人",
      "side": "Left",
      "expression": "",
      "clearOther": false,
      "text": "他举戈击地，绕火踏步。火中渐渐现出一条路，路旁妖异燃烧，天上流星如雨。",
      "next": "r0006",
      "outcome": "",
      "blocking": true,
      "performance": "",
      "choices": []
    },
    {
      "id": "r0006",
      "revision": 1,
      "kind": "Line",
      "speaker": "storyteller",
      "speakerName": "说书人",
      "side": "Left",
      "expression": "",
      "clearOther": false,
      "text": "“凡汝阴类，悉就消忘！”",
      "next": "r0007",
      "outcome": "",
      "blocking": true,
      "performance": "",
      "choices": []
    },
    {
      "id": "r0007",
      "revision": 1,
