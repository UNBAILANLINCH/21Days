      "kind": "Line",
      "speaker": "",
      "speakerName": "王录业",
      "side": "Left",
      "expression": "",
      "clearOther": false,
      "text": "今年泾川人报多见灾异，水位变化异常，妖鬼搏人而噬。事必有异。",
      "next": "r0153",
      "outcome": "",
      "blocking": true,
